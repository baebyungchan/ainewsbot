# --- required ---
TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_CHAT_ID=123456789

# --- optional: Reddit official API (recommended; anonymous access is blocked from cloud IPs) ---
# Create a "script" app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=github-actions:ainewsbot:1.0 (by /u/yourname)

# --- optional: Claude one-line takes per item (default is plain formatting) ---
ANTHROPIC_API_KEY=
BRIEFING_PROVIDER=rules        # rules | claude
CLAUDE_MODEL=claude-opus-5

# --- optional: X via a self-hosted Nitter-compatible RSS ---
X_RSS_BASE=
X_ACCOUNTS=OpenAI,AnthropicAI,GoogleDeepMind

# --- optional tuning (defaults shown) ---
DRY_RUN=false
MAX_ITEMS_PER_RUN=8
BOOTSTRAP_LIMIT=5
QUIET_HOURS_KST=0-8
GITHUB_TRENDING_MIN_STARS_TODAY=500
GITHUB_TRENDING_ANY_TOPIC_MIN=2000
GITHUB_NEW_MIN_STARS=500
GITHUB_NEW_MAX_AGE_DAYS=14
HN_MIN_POINTS=100
REDDIT_RSS_TOP_N=5
